{
	"name": "personal-informations",
	"main": "worker/index.ts",
	"compatibility_date": "2026-01-01",
	"observability": {
		"enabled": true,
		"logs": {
			"invocation_logs": true,
			"head_sampling_rate": 1
		}
	},
	"assets": {
		"binding": "ASSETS",
		"directory": "./dist",
		"run_worker_first": [
			"/api/*"
		],
		"not_found_handling": "single-page-application"
	},
    "d1_databases": [
        {
            "binding": "DB",
            "database_name": "personal-informations",
            "database_id": "5d7daf50-b810-42d1-adb5-722d154e2aae",
            "migrations_dir": "migrations"
        }
    ]
}
