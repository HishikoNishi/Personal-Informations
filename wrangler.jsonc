{
	"name": "personal-informations",
	"main": "worker/index.ts",
	"compatibility_date": "2026-01-01",
	"assets": {
		"binding": "ASSETS",
		"directory": "./dist",
		"run_worker_first": [
			"/api/*"
		],
		"not_found_handling": "single-page-application"
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "personal-informations",
			// Replace this placeholder with the ID returned by `wrangler d1 create`.
			"database_id": "5d7daf50-b810-42d1-adb5-722d154e2aae",
			"migrations_dir": "migrations"
		},
		{
			"binding": "personal_informations",
			"database_name": "personal-informations",
			"database_id": "5d7daf50-b810-42d1-adb5-722d154e2aae"
		}
	]
}